{
  "name": "bookishai",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "app:dev": "cd app && vite dev",
    "app:build": "cd app && vite build",
    "app:preview": "cd app && vite preview",
    "app:check": "cd app && svelte-check --tsconfig ../tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,svelte}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,svelte}\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "server:dev": "tsx watch src/main.ts",
    "server:start": "tsx src/main.ts",
    "setup": "./setup",
    "project": "concurrently -n \"api,svelte\" -c \"magenta,cyan\" \"pnpm run server:dev\" \"pnpm run app:dev\"",
    "dev:all": "pnpm run project",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@lancedb/lancedb": "^0.38.0",
    "@loglayer/transport-pino": "^3.3.0",
    "@mastra/core": "1.67.0",
    "@mastra/duckdb": "1.9.0",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.30.0",
    "@mastra/observability": "1.17.8",
    "@mastra/rag": "^2.6.3",
    "ai": "^7.0.99",
    "ai-sdk-ollama": "^4.3.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "katex": "^0.18.7",
    "loglayer": "^9.4.0",
    "marked": "^18.0.13",
    "marked-katex-extension": "^5.1.13",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.47.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/marked": "^6.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "latest",
    "@types/pdf-parse": "^1.1.5",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "lucide-svelte": "^1.0.1",
    "mastra": "1.30.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "s3rver": "^3.7.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16"
  }
}
