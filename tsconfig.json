{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "$lib": ["app/src/lib"],
      "$lib/*": ["app/src/lib/*"]
    },
    "noEmit": true,
    "outDir": "dist"
  },
  "include": [
    "ambient.d.ts",
    "src/**/*",
    "app/src/**/*",
    "app/vite.config.ts",
    "config/app.config.ts"
  ]
}
