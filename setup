#!/usr/bin/env bash
set -e

echo "=========================================="
echo "      BookishAI Environment Setup         "
echo "=========================================="

# 1. Check Node.js
echo "[1/6] Checking Node.js installation..."
if ! command -v node >/dev/null 2>&1; then
    echo "ERROR: Node.js is not installed. Please install Node.js (>= 22.13.0)."
    exit 1
fi

NODE_VERSION=$(node -v)
echo "   -> Node.js version ${NODE_VERSION} detected."

# 2. Check / Install pnpm
echo "[2/6] Checking pnpm package manager..."
if ! command -v pnpm >/dev/null 2>&1; then
    echo "   -> pnpm not found. Installing pnpm globally..."
    npm install -g pnpm || corepack enable
else
    echo "   -> pnpm version $(pnpm -v) detected."
fi

# 3. Install Node.js dependencies
echo "[3/6] Installing project dependencies with pnpm..."
pnpm install

# 4. Check / Install Ollama
echo "[4/6] Checking Ollama installation..."
if ! command -v ollama >/dev/null 2>&1; then
    echo "   -> Ollama is not installed on this system."
    echo "   -> Downloading and running Ollama installer script..."
    curl -fsSL https://ollama.com/install.sh | sh
else
    echo "   -> Ollama binary detected: $(ollama -v 2>/dev/null || echo 'ready')"
fi

# 5. Ensure Ollama server daemon is running
echo "[5/6] Verifying Ollama service..."
if ! curl -s http://localhost:11434/api/tags >/dev/null 2>&1; then
    echo "   -> Ollama service is not running. Launching background daemon..."
    ollama serve >/dev/null 2>&1 &
    sleep 3
    if ! curl -s http://localhost:11434/api/tags >/dev/null 2>&1; then
        echo "WARNING: Could not connect to Ollama server at http://localhost:11434."
        echo "Please make sure Ollama is running before starting the app."
    else
        echo "   -> Ollama daemon successfully started."
    fi
else
    echo "   -> Ollama service is active at http://localhost:11434."
fi

# 6. Pull & Configure required models
echo "[6/6] Pulling and setting up local models..."

echo "   -> Pulling base model qwen3:1.7b..."
ollama pull qwen3:1.7b || true

if [ -f "Modelfile.qwen3-8k" ]; then
    echo "   -> Creating custom qwen3:1.7b-8k model from Modelfile.qwen3-8k..."
    ollama create qwen3:1.7b-8k -f Modelfile.qwen3-8k || true
fi

echo "   -> Pulling light model qwen2.5:0.5b..."
ollama pull qwen2.5:0.5b || true

echo "   -> Pulling embedding model nomic-embed-text..."
ollama pull nomic-embed-text || true

echo "=========================================="
echo " SUCCESS: BookishAI setup completed!      "
echo " You can now start the stack by running:  "
echo "    pnpm run project                      "
echo "=========================================="
